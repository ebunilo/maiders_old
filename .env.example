# --- Used by docker-compose.yml (db + app services) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=users-db
APP_PORT=8000
WEB_CONCURRENCY=1

# Signs session cookies. Required for real deployments — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Every app worker/replica must share this same value, and it must not
# change across restarts, or everyone gets logged out.
SECRET_KEY=secure-dev-secret-change-me

# If set, and no user accounts exist yet, this admin account is created
# automatically the first time the app starts. Leave unset after the first
# login and manage users with `scripts/create_user.py` instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Only needed when running the app directly with uvicorn (no Docker) ---
# Overrides the DATABASE_URL the compose-based app/import services build
# automatically from the POSTGRES_* vars above.
# DATABASE_URL=postgresql+psycopg2://maiders:change-me@localhost:5432/maiders
